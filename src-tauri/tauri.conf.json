{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Editor Saucedo",
  "version": "0.7.0",
  "identifier": "mx.saucedo.editor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Editor Saucedo · Video y Fotografía",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "maximized": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Eduardo Saucedo · Video & Fotografía",
    "shortDescription": "Editor de fotos y video",
    "longDescription": "Plantillas de video con música incluida, fotosecuencias, Save the Date, videoclip de XV años, película del evento, mejorar colores y marca de agua para Eduardo Saucedo · Video & Fotografía.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "musica/*.mp3": "musica/"
    }
  }
}