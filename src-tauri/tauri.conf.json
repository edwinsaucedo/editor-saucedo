{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Editor Saucedo",
  "version": "0.1.0",
  "identifier": "mx.saucedo.editor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Editor Saucedo · Video y Fotografía",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "maximized": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Saucedo Video y Fotografía",
    "shortDescription": "Editor de fotos y video",
    "longDescription": "Plantillas de Save the Date y videoclip de XV años, mejorar colores y marca de agua para Saucedo Video y Fotografía.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  }
}
